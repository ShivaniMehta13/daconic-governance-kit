FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home daconic && mkdir /state && chown daconic:daconic /state
COPY examples/observation_policies /policies
USER 10001:10001
EXPOSE 8080
VOLUME ["/state"]
ENTRYPOINT ["daconic", "observe-serve", "--state", "/state", "--policies", "/policies", "--host", "0.0.0.0", "--port", "8080"]
